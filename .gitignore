# Credentials en ruwe API-data horen niet in versiebeheer.
.env
.env.*

# Je echte naam staat in de schermafbeelding van de Canvas-tokenpagina.
docs/canvas-token-details.png

# Ruwe Canvas-antwoorden kunnen persoonlijke gegevens bevatten.
data/raw/

# Gegenereerd uit je eigen account: bevat je opdrachtnamen en omschrijvingen.
# Let op: het patroon eindigt op /docs/... en niet op de map zelf, zodat er
# later wél iets anders in die mappen getrackt kan worden.
/docs/portfolio-dossier.md
/data/portfolio_assignments.json

# Lokale toestand van het dashboard.
dashboard/state.json
dashboard/documents.json

# Schermafbeeldingen van je eigen portfolio: alleen voor lokaal gebruik.
dashboard/preview/

# Superdesign: de tijdelijke map nooit committen (de skill eist dit).
# .superdesign/init/ en design-system.md bevatten alleen ontwerpcontext en
# mogen wel mee.
.superdesign/tmp/
.superdesign/website/

# Het browserprofiel bevat je ingelogde Fontys-sessie: net zo gevoelig als een
# wachtwoord. Nooit in versiebeheer.
browser/.chrome-profile/
browser/out/

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/

# Tijdelijk
*.tmp
*.log
data/tijdelijk/

# Cursusmateriaal van Fontys: auteursrechtelijk materiaal en te groot voor een
# publieke repo. Hoort lokaal te blijven.
docs/stage/

# Alles wat uit je eigen Canvas- en Portflow-account komt. Hier staan je
# cursusnamen, mededelingen, leeruitkomsten en je portfolio-id's in. Dat is
# persoonlijk en hoort niet op GitHub.
data/canvas-state.json
data/course-intel.json
data/leeruitkomsten.json
data/lo-koppeling.json
data/documenten/

# De stagebot houdt bij welke bedrijven je hebt benaderd en wat ze antwoordden.
# Dat is een zakelijk dossier, geen openbaar bestand.
data/stagebot/

# Tijdelijk bestand voor een commit-boodschap.
.git-commit-msg.txt
